{
  "name": "@remix-kbn/assets-deno",
  "version": "0.9.0",
  "license": "MIT",
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "esnext"
    ]
  },
  "exports": "./src/mod.ts",
  "imports": {
    "@deno/loader": "jsr:@deno/loader@^0.5.0",
    "@remix-run/assert": "npm:@remix-run/assert@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "cjs-module-lexer": "npm:cjs-module-lexer@^2.2.1",
    "es-module-lexer": "npm:es-module-lexer@^2.3.2"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --unstable-bundle",
    "check": "deno check src"
  },
  "publish": {
    "include": [
      "src",
      "README.md",
      "LICENSE",
      "deno.json"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/__fixtures__"
    ]
  }
}
