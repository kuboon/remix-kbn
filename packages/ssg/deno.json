{
  "name": "@remix-kbn/ssg",
  "version": "0.12.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./node": "./src/node.ts",
    "./site": "./src/site.ts",
    "./base": "./src/base.ts",
    "./client": "./src/client.ts",
    "./build.ts": "./src/build.ts"
  },
  "imports": {
    "@remix-kbn/assets-deno": "jsr:@remix-kbn/assets-deno@^0.8.0",
    "@remix-run/assert": "npm:@remix-run/assert@^0.3.0",
    "@remix-run/response/html": "npm:@remix-run/response@^0.3.8/html",
    "@std/cli/parse-args": "jsr:@std/cli@^1/parse-args",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^0.22.0",
    "@remix-run/ui": "npm:@remix-run/ui@^0.10.0",
    "@remix-run/ui/server": "npm:@remix-run/ui@^0.10.0/server",
    "es-module-lexer": "npm:es-module-lexer@^2.3.0"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --unstable-bundle",
    "check": "deno check src"
  },
  "publish": {
    "include": [
      "src",
      "README.md",
      "LICENSE",
      "deno.json"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/__fixtures__"
    ]
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/ui",
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  }
}
