{
  "name": "@remix-kbn/ssg",
  "version": "0.12.0",
  "license": "MIT",
  "exports": {
    "./site": "./src/site.ts",
    "./base": "./src/base.ts",
    "./build.ts": "./src/build.ts"
  },
  "imports": {
    "@remix-run/assert": "npm:@remix-run/assert@^0.3.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^0.22.0",
    "@std/cli/parse-args": "jsr:@std/cli@^1/parse-args",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "es-module-lexer": "npm:es-module-lexer@^2.3.0"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-net",
    "check": "deno check src"
  },
  "publish": {
    "include": [
      "src",
      "README.md",
      "LICENSE",
      "deno.json"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/__fixtures__"
    ]
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  }
}
